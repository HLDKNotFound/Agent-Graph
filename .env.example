# ==========================================
# Enterprise Knowledge Agent – Environment Configuration Template
# All production values must be supplied via secure secrets manager or runtime env
# ==========================================

# ------------------------------------------
# Database & Relational Storage (PostgreSQL 16+ with pgvector)
# ------------------------------------------
DATABASE_URL="postgresql://postgres:password@localhost:5432/agentgraph_db?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/agentgraph_db?schema=public"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password"
POSTGRES_DB="agentgraph_db"

# ------------------------------------------
# Vector Database (Qdrant v1.8+)
# ------------------------------------------
QDRANT_HOST="localhost"
QDRANT_PORT="6333"
QDRANT_GRPC_PORT="6334"
QDRANT_API_KEY=""
QDRANT_COLLECTION="enterprise_knowledge_chunks"
QDRANT_HNSW_M="16"
QDRANT_HNSW_EF_CONSTRUCT="128"
QDRANT_HNSW_EF="64"

# ------------------------------------------
# Redis Cache & Celery Task Queue
# ------------------------------------------
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# ------------------------------------------
# Object Storage (S3 / Cloudflare R2 / MinIO)
# ------------------------------------------
S3_ENDPOINT_URL=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="enterprise-knowledge-docs"
S3_REGION="us-east-1"

# ------------------------------------------
# Models: Embeddings & Reranker
# ------------------------------------------
EMBEDDING_MODEL_NAME="BAAI/bge-m3"
EMBEDDING_DIMENSION="1024"
RERANKER_MODEL_NAME="BAAI/bge-reranker-v2-m3"
RERANKER_MAX_CANDIDATES="40"
RERANKER_TOP_K="5"

# ------------------------------------------
# LLM Providers (OpenAI, Azure, Anthropic, or Local vLLM)
# ------------------------------------------
LLM_PROVIDER="openai"
LLM_API_KEY=""
LLM_MODEL_NAME="gpt-4o"
LLM_TEMPERATURE="0.1"
LLM_MAX_TOKENS="2048"

# ------------------------------------------
# External Web Search (For OUT_OF_DOMAIN Queries)
# ------------------------------------------
WEB_SEARCH_PROVIDER="tavily"
WEB_SEARCH_API_KEY=""
WEB_SEARCH_MAX_RESULTS="5"

# ------------------------------------------
# Application Security & Authentication
# ------------------------------------------
JWT_SECRET_KEY="generate-strong-256-bit-secret-for-production"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES="60"
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# ------------------------------------------
# Multi-Hop Reasoning & Guardrails
# ------------------------------------------
MAX_HOPS_LIMIT="3"
QUERY_CYCLE_SIMILARITY_THRESHOLD="0.95"
HALLUCINATION_NLI_MODEL="cross-encoder/nli-deberta-v3-base"
FAITHFULNESS_SLA_TARGET="0.90"

# ------------------------------------------
# Observability & Tracing (Langfuse & Prometheus)
# ------------------------------------------
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST="https://cloud.langfuse.com"
PROMETHEUS_METRICS_ENABLED="true"
PROMETHEUS_METRICS_PORT="9090"
LOG_LEVEL="INFO"
