{
  "name": "enterprise-knowledge-backend",
  "version": "1.0.0",
  "description": "Enterprise Knowledge Agent - PostgreSQL 16+ & Prisma ORM Infrastructure",
  "private": true,
  "scripts": {
    "prisma:validate": "prisma validate --schema backend/schema.prisma",
    "prisma:generate": "prisma generate --schema backend/schema.prisma",
    "prisma:format": "prisma format --schema backend/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema backend/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema backend/schema.prisma",
    "prisma:status": "prisma migrate status --schema backend/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
