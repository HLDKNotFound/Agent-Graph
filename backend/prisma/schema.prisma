// Prisma schema for Enterprise Knowledge Agent – Multi-Tenant IAM Core, Granular RBAC & Session Management
// Database: PostgreSQL 16+ with pgvector extension

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

// ==========================================
// INFRASTRUCTURE & HEALTH
// ==========================================

/// Core infrastructure model for database health checks and connectivity verification.
/// Preserved from Task 01 database infrastructure initialization.
model DatabaseHealth {
  id        String   @id @default(cuid())
  status    String   @default("HEALTHY")
  checkedAt DateTime @default(now()) @map("checked_at")

  @@map("database_health")
}

// ==========================================
// ENUMS
// ==========================================

enum TenantStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  LOCKED
}

enum RoleScope {
  SYSTEM
  TENANT
}

enum DocumentClassification {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

enum DocumentIngestionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

// ==========================================
// MULTI-TENANT IDENTITY & ACCESS MANAGEMENT (IAM)
// ==========================================

/// Represents an independent organization using the platform.
model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @db.VarChar(255)
  slug      String       @unique @db.VarChar(100)
  status    TenantStatus @default(ACTIVE)
  config    Json?        @default("{}")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  users       User[]
  roles       Role[]
  departments Department[]
  sessions    Session[]
  auditLogs        AuditLog[]
  documents        Document[]
  documentVersions DocumentVersion[]

  @@map("tenants")
}

/// Represents an organizational department supporting hierarchical structures and management.
model Department {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(255)
  description String?  @db.Text
  parentId    String?  @map("parent_id") @db.Uuid
  managerId   String?  @map("manager_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent    Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Department[] @relation("DepartmentHierarchy")
  manager   User?        @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)
  users     User[]       @relation("DepartmentMembers")
  documents Document[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([parentId])
  @@index([managerId])
  @@map("departments")
}

/// Represents an authenticated platform user.
model User {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  departmentId String?    @map("department_id") @db.Uuid
  email        String     @db.VarChar(255)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  fullName     String     @map("full_name") @db.VarChar(255)
  status       UserStatus @default(ACTIVE)
  metadata     Json?      @default("{}")
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  tenant             Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department         Department?  @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: SetNull)
  managedDepartments Department[] @relation("DepartmentManager")
  roles              UserRole[]   @relation("UserToUserRoles")
  assignedRoles      UserRole[]   @relation("UserRoleAssignedBy")
  sessions           Session[]
  auditLogs               AuditLog[]
  uploadedDocuments       Document[]        @relation("DocumentUploader")
  createdDocumentVersions DocumentVersion[] @relation("DocumentVersionCreator")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([departmentId])
  @@map("users")
}

/// Represents an authorization role (system-defined or tenant-defined).
model Role {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String?   @map("tenant_id") @db.Uuid
  name        String    @db.VarChar(100)
  description String?   @db.Text
  scope       RoleScope @default(TENANT)
  permissions Json?     @default("[]")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles       UserRole[]       @relation("RoleToUserRoles")
  rolePermissions RolePermission[] @relation("RoleToRolePermissions")

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([scope])
  @@map("roles")
}

// ==========================================
// ROLE-BASED ACCESS CONTROL (RBAC) & PERMISSION MANAGEMENT
// ==========================================

/// Represents an individual authorization capability within the platform.
model Permission {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @db.VarChar(100)
  key         String     @unique @db.VarChar(100)
  description String?    @db.Text
  resource    String     @db.VarChar(100)
  action      String     @db.VarChar(100)
  scope       RoleScope? @default(SYSTEM)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  rolePermissions RolePermission[] @relation("PermissionToRolePermissions")

  @@index([resource])
  @@index([action])
  @@index([resource, action])
  @@map("permissions")
}

/// Implements the explicit many-to-many relationship between roles and permissions.
model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  // Relationships
  role       Role       @relation("RoleToRolePermissions", fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation("PermissionToRolePermissions", fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Implements the explicit many-to-many relationship between users and roles with audit history.
model UserRole {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  assignedById String?  @map("assigned_by_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  metadata     Json?    @default("{}")

  // Relationships
  user       User  @relation("UserToUserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation("RoleToUserRoles", fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("UserRoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@index([assignedById])
  @@map("user_roles")
}

// ==========================================
// AUTHENTICATION & SESSION MANAGEMENT
// ==========================================

/// Represents an authenticated user session with secure token hashing,
/// device tracking, activity monitoring, and explicit revocation.
model Session {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  ipAddress      String?   @map("ip_address") @db.Inet
  userAgent      String?   @map("user_agent") @db.Text
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastActivityAt DateTime  @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)

  // Relationships
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("sessions")
}

// ==========================================
// ENTERPRISE AUDIT LOGGING & GOVERNANCE
// ==========================================

/// Represents an immutable, append-only audit log entry for security-sensitive,
/// compliance, and business-critical operations across the enterprise platform.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  actorType  String   @default("USER") @map("actor_type") @db.VarChar(50)
  action     String   @db.VarChar(100)
  targetType String   @map("target_type") @db.VarChar(100)
  targetId   String?  @map("target_id") @db.VarChar(255)
  metadata   Json?    @default("{}")
  ipAddress  String?  @map("ip_address") @db.Inet
  requestId  String?  @map("request_id") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relationships
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Composite & Query Optimization Indexes
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, userId, createdAt(sort: Desc)])
  @@index([tenantId, action, createdAt(sort: Desc)])
  @@index([tenantId, targetType, targetId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([action])
  @@index([targetType, targetId])
  @@index([requestId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ==========================================
// DOCUMENT METADATA & CLASSIFICATION MANAGEMENT
// ==========================================

/// Represents an enterprise document ingested into the knowledge retrieval platform,
/// maintaining lifecycle tracking, storage references, SHA-256 content deduplication,
/// security classification, and organizational ownership.
model Document {
  id                 String                  @id @default(uuid()) @db.Uuid
  tenantId           String                  @map("tenant_id") @db.Uuid
  departmentId       String?                 @map("department_id") @db.Uuid
  uploadedById       String?                 @map("uploaded_by_id") @db.Uuid
  currentVersionId   String?                 @unique @map("current_version_id") @db.Uuid
  originalFilename   String                  @map("original_filename") @db.VarChar(255)
  normalizedFilename String                  @map("normalized_filename") @db.VarChar(255)
  storageUri         String                  @map("storage_uri") @db.Text
  mimeType           String                  @map("mime_type") @db.VarChar(100)
  fileSizeBytes      BigInt                  @map("file_size_bytes")
  contentHash        String                  @map("content_hash") @db.VarChar(64)
  classification     DocumentClassification  @default(INTERNAL)
  status             DocumentIngestionStatus @default(PENDING)
  metadata           Json?                   @default("{}")
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?               @map("deleted_at") @db.Timestamptz(6)

  // Relationships
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department     Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  uploadedBy     User?             @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  currentVersion DocumentVersion?  @relation("DocumentCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       DocumentVersion[] @relation("DocumentVersions")

  // Query Optimization & Deduplication Indexes
  @@index([tenantId, contentHash])
  @@index([tenantId, classification])
  @@index([tenantId, status])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([uploadedById])
  @@index([departmentId])
  @@map("documents")
}

// ==========================================
// DOCUMENT VERSIONING & HISTORICAL LINEAGE
// ==========================================

/// Represents an immutable historical version snapshot of an enterprise document,
/// preserving historical content hashes, file sizes, storage URIs, extraction metadata,
/// and line-level chunk lineage across document revisions.
model DocumentVersion {
  id               String                  @id @default(uuid()) @db.Uuid
  documentId       String                  @map("document_id") @db.Uuid
  tenantId         String                  @map("tenant_id") @db.Uuid
  createdById      String?                 @map("created_by_id") @db.Uuid
  versionNumber    Int                     @map("version_number")
  storageUri       String                  @map("storage_uri") @db.Text
  originalFilename String                  @map("original_filename") @db.VarChar(255)
  mimeType         String                  @map("mime_type") @db.VarChar(100)
  fileSizeBytes    BigInt                  @map("file_size_bytes")
  contentHash      String                  @map("content_hash") @db.VarChar(64)
  status           DocumentIngestionStatus @default(PENDING)
  metadata         Json?                   @default("{}")
  isCurrent        Boolean                 @default(false) @map("is_current")
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt        DateTime?               @map("deleted_at") @db.Timestamptz(6)

  // Relationships
  document           Document  @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  currentForDocument Document? @relation("DocumentCurrentVersion")
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy          User?     @relation("DocumentVersionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  // Optimization, Lineage & Tenant Isolation Indexes
  @@unique([documentId, versionNumber])
  @@index([tenantId, documentId])
  @@index([tenantId, contentHash])
  @@index([tenantId, status])
  @@index([documentId, isCurrent])
  @@index([createdById])
  @@index([createdAt(sort: Desc)])
  @@map("document_versions")
}
